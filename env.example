# Auto Research local runtime — copy to .env and source it, or export
# these in your shell. Tokens are trusted configuration: never commit the
# real values.

# Corpus root (this repo). The runtime reads and writes roam/ here.
export AR_CORPUS_ROOT="$HOME/starintel/auto-research-llm-cl"

# Where the CL runtime systems live (ASDF source tree).
export AR_RUNTIME_SOURCE="$HOME/git/worktrees/auto-research-harness-cl-runtime/"

# Web API
export AR_WEB_PORT=8080
export AR_WEB_ADDRESS=127.0.0.1

# Bearer tokens for the API (defaults: dev-operator-token / dev-readonly)
export AR_OPERATOR_TOKEN=dev-operator-token
export AR_READONLY_TOKEN=dev-readonly

# Forgejo webhook verification (fail-closed when unset)
export FORGEJO_WEBHOOK_SECRET=change-me

# LLM backend (semantic stages fail closed when the key is unset)
export OPENROUTER_API_KEY=
export AR_MODEL=openai/gpt-4.1-mini
export RLM_PROVIDER_TIMEOUT=240

# Non-nix SBCL needs the openssl libs for dexador/cl+ssl:
export LD_LIBRARY_PATH=/nix/store/hg41dqig0qxm7shyi0a0xkw29a14i3js-openssl-3.6.3/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
